#!/bin/sh
set -eu

phase=${1:-}
if [ "$phase" != prepared ]; then
  exit 0
fi

case "$0" in
  */*) hook_dir=${0%/*} ;;
  *) hook_dir=. ;;
esac
hook_dir=$(CDPATH='' cd -- "$hook_dir" && pwd)
guard_path_file="$hook_dir/glm-publication-guard.path"
if [ ! -f "$guard_path_file" ] || [ -L "$guard_path_file" ]; then
  printf '%s\n' 'publication guard rejected: configured controller guard path unavailable' >&2
  exit 1
fi
if ! IFS= read -r publication_guard <"$guard_path_file"; then
  printf '%s\n' 'publication guard rejected: configured controller guard path unreadable' >&2
  exit 1
fi
case "$publication_guard" in
/*) ;;
*)
  printf '%s\n' 'publication guard rejected: configured controller guard path is not absolute' >&2
  exit 1
  ;;
esac
if [ ! -x "$publication_guard" ]; then
  printf '%s\n' 'publication guard rejected: configured controller guard is not executable' >&2
  exit 1
fi
if ! repo_root=$(git rev-parse --show-toplevel 2>/dev/null); then
  printf '%s\n' 'publication guard rejected: repository root unavailable' >&2
  exit 1
fi

while IFS=' ' read -r old_oid new_oid ref_name; do
  case "$ref_name" in
  refs/heads/*)
    if ! (cd "$repo_root" && "$publication_guard" ref-update --old "$old_oid" --new "$new_oid" --ref "$ref_name" >/dev/null); then
      printf 'publication ref update rejected: %s\n' "$ref_name" >&2
      exit 1
    fi
    ;;
  esac
done
