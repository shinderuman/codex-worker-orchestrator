prefix_rule(
    pattern = ["git", "push"],
    decision = "forbidden",
    justification = "Publication remote writes are machine-owned in this repository; use glm-parent-action push-binding push-guard --publish after candidate Gates pass.",
)

prefix_rule(
    pattern = ["git", "-c"],
    decision = "forbidden",
    justification = "Per-command Git configuration can disable repository-managed publication hooks in this repository.",
)

prefix_rule(
    pattern = ["git", "config", "core.hooksPath"],
    decision = "forbidden",
    justification = "core.hooksPath is repository-managed publication authority in this repository.",
)

prefix_rule(
    pattern = ["git", "config", "--local", "core.hooksPath"],
    decision = "forbidden",
    justification = "core.hooksPath is repository-managed publication authority in this repository.",
)

prefix_rule(
    pattern = ["git", "config", ["--unset", "--unset-all"], "core.hooksPath"],
    decision = "forbidden",
    justification = "core.hooksPath is repository-managed publication authority in this repository.",
)

prefix_rule(
    pattern = ["git", "config", "--local", ["--unset", "--unset-all"], "core.hooksPath"],
    decision = "forbidden",
    justification = "core.hooksPath is repository-managed publication authority in this repository.",
)
